#!/bin/sh

CONFIG=${OXIDNS_CONFIG:-/etc/oxidns/config.yaml}
PASSWORD_FILE=${OXIDNS_PASSWORD_FILE:-/etc/oxidns/initial_password}
SERVICE=/etc/init.d/oxidns
WORKDIR=${OXIDNS_WORKDIR:-/var/lib/oxidns}
PLACEHOLDER=__OXIDNS_GENERATE_ON_INSTALL__
ENV_PLACEHOLDER='${OXIDNS_API_PASSWORD:-__OXIDNS_GENERATE_ON_INSTALL__}'

umask 077

fail() {
	echo "oxidns-openwrt: $*" >&2
	exit 1
}

generate_password() {
	if [ -r /dev/urandom ]; then
		LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 24
	else
		date +%s | sha256sum | cut -c 1-24
	fi
}

read_config_password() {
	[ -f "$CONFIG" ] || return 1
	awk -F: '
		/^[[:space:]]*password:[[:space:]]*/ {
			sub(/^[[:space:]]*password:[[:space:]]*/, "", $0)
			gsub(/^["'\'']|["'\'']$/, "", $0)
			print $0
			exit
		}
	' "$CONFIG"
}

password_is_placeholder() {
	[ "$1" = "$PLACEHOLDER" ] || [ "$1" = "$ENV_PLACEHOLDER" ]
}

write_password_file() {
	local password="$1"

	mkdir -p "$(dirname "$PASSWORD_FILE")"
	printf '%s\n' "$password" > "$PASSWORD_FILE"
	chmod 600 "$PASSWORD_FILE"
}

json_escape() {
	printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

mask_config_password_line() {
	sed 's|^\([[:space:]]*password:[[:space:]]*\).*$|\1"__OXIDNS_PASSWORD__"|'
}

normalize_config_for_migration() {
	mask_config_password_line | sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d'
}

migrate_opkg_config_if_safe() {
	local opkg_config="${CONFIG}-opkg"
	local old_masked
	local new_masked
	local password

	[ -f "$opkg_config" ] || return 0
	[ -f "$CONFIG" ] || {
		mv "$opkg_config" "$CONFIG"
		chmod 600 "$CONFIG"
		return 0
	}

	old_masked="${CONFIG}.old-mask.$$"
	new_masked="${CONFIG}.new-mask.$$"
	normalize_config_for_migration < "$CONFIG" > "$old_masked" || {
		rm -f "$old_masked" "$new_masked"
		return 0
	}
	normalize_config_for_migration < "$opkg_config" > "$new_masked" || {
		rm -f "$old_masked" "$new_masked"
		return 0
	}

	if cmp -s "$old_masked" "$new_masked"; then
		password="$(read_config_password)"
		if [ -n "$password" ] && ! password_is_placeholder "$password"; then
			write_password_file "$password"
		fi
		cat "$opkg_config" > "$CONFIG"
		rm -f "$opkg_config"
		chmod 600 "$CONFIG"
	fi

	rm -f "$old_masked" "$new_masked"
}

init_config() {
	mkdir -p "$(dirname "$CONFIG")" "$WORKDIR"

	[ -f "$CONFIG" ] || fail "config not found: $CONFIG"
	migrate_opkg_config_if_safe

	if [ ! -s "$PASSWORD_FILE" ]; then
		local password
		password="$(read_config_password)"
		if [ -n "$password" ] && ! password_is_placeholder "$password"; then
			write_password_file "$password"
		else
			reset_password "no-restart" >/dev/null
		fi
		return 0
	fi

	chmod 600 "$PASSWORD_FILE"
}

show_password() {
	if [ -s "$PASSWORD_FILE" ]; then
		cat "$PASSWORD_FILE"
		return 0
	fi

	read_config_password
}

reset_password() {
	local mode="$1"
	local password

	password="$(generate_password)"
	[ -n "$password" ] || fail "failed to generate password"

	write_password_file "$password"

	if [ "$mode" != "no-restart" ] && pidof oxidns >/dev/null 2>&1; then
		"$SERVICE" restart >/dev/null 2>&1 || true
	fi

	printf '%s\n' "$password"
}

service_running() {
	pidof oxidns >/dev/null 2>&1
}

service_enabled() {
	"$SERVICE" enabled >/dev/null 2>&1
}

status_json() {
	local running=false
	local enabled=false
	local password
	local escaped_password

	service_running && running=true
	service_enabled && enabled=true
	password="$(show_password 2>/dev/null)"
	escaped_password="$(json_escape "$password")"

	printf '{"running":%s,"enabled":%s,"username":"admin","password":"%s"}\n' \
		"$running" "$enabled" "$escaped_password"
}

case "$1" in
	init-config)
		init_config
		;;
	show-password)
		show_password
		;;
	reset-password)
		reset_password
		;;
	status)
		status_json
		;;
	start)
		"$SERVICE" enable >/dev/null 2>&1 || true
		"$SERVICE" start >/dev/null 2>&1 || true
		status_json
		;;
	stop)
		"$SERVICE" stop >/dev/null 2>&1 || true
		status_json
		;;
	restart)
		"$SERVICE" restart >/dev/null 2>&1 || true
		status_json
		;;
	*)
		echo "Usage: $0 {init-config|show-password|reset-password|status|start|stop|restart}" >&2
		exit 2
		;;
esac
